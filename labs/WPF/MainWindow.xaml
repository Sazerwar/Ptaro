<Window x:Class="ThreeCylindersVisualization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Three Cylinders Visualization"
        Height="560" Width="520"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Text="Візуалізація роботи трьох потоків"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>


        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Border BorderBrush="Black" BorderThickness="2" Width="140" Height="360" Margin="6">
                <StackPanel x:Name="Cylinder1" VerticalAlignment="Top"/>
            </Border>

            <Border BorderBrush="Black" BorderThickness="2" Width="140" Height="360" Margin="6">
                <StackPanel x:Name="Cylinder2" VerticalAlignment="Top"/>
            </Border>

            <Border BorderBrush="Black" BorderThickness="2" Width="140" Height="360" Margin="6">
                <StackPanel x:Name="Cylinder3" VerticalAlignment="Top"/>
            </Border>
        </StackPanel>


        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,12,0,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Rectangle Width="20" Height="12" Fill="Blue" Margin="3"/>
                <TextBlock Text="Працює" VerticalAlignment="Center" Margin="6,0"/>
                <Rectangle Width="20" Height="12" Fill="Red" Margin="12,3,3,3"/>
                <TextBlock Text="Простоює" VerticalAlignment="Center" Margin="6,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusLabel" Text="Готовий до запуску"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button x:Name="StartBtn" Content="Run" Width="80" Margin="6" Click="StartBtn_Click"/>
                <Button x:Name="StopBtn" Content="Stop" Width="80" Margin="6" Click="StopBtn_Click" IsEnabled="False"/>
                <Button Content="Exit" Width="80" Margin="6" Click="ExitBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
